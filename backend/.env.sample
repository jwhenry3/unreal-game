# Copy to .env and replace the placeholder secrets with random values.
NODE_ENV=development
# Port 3000 is occupied by the Unreal Editor MCP HTTP surface; use 3100 for the backend.
PORT=3100
DATABASE_PATH=./data/auth.sqlite
# Optional local collector; events are dropped when URL or key is absent.
OBSERVABILITY_URL=http://127.0.0.1:4100
OBSERVABILITY_API_KEY=local-observability-key
OBSERVABILITY_SERVICE=mygame-backend
# NOTE: these development secrets match the defaults expected by the local game server.
JWT_SECRET=local-development-jwt-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REMEMBER_ME_REFRESH_TTL_SECONDS=7776000
GAME_SERVERS=North America,Europe,Asia
INTERNAL_API_KEYS=local-development-service-key
MAX_CHARACTERS_PER_ACCOUNT=8
MAIL_TTL_HOURS=720
# Browser-only CORS allowlist. Unreal server-to-server calls do not need CORS.
# UI dev server (Vite) runs on 5173; leave blank to allow any origin in development.
CORS_ORIGIN=
