OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=4100
OBSERVABILITY_API_KEY=local-observability-key
OBSERVABILITY_RETENTION_DAYS=7
OBSERVABILITY_PROJECT_ROOT=..
OBSERVABILITY_DATABASE_PATH=./data/observability.sqlite
OBSERVABILITY_LOG_TAIL_LINES=500
# Semicolon-separated paths relative to OBSERVABILITY_PROJECT_ROOT.
OBSERVABILITY_WATCH_PATHS=backend/logs;Saved/Logs
# CMS content uses its own SQLite database. Account management calls backend internal APIs.
CMS_DATABASE_PATH=./data/cms.sqlite
CMS_BACKEND_URL=http://127.0.0.1:3100
CMS_BACKEND_SERVICE_KEY=local-development-service-key
