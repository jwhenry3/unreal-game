{
  "name": "mygame-operations",
  "version": "0.2.0",
  "private": true,
  "description": "Local CMS and observability operations application for MyGame",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build --configLoader runner",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:dev": "npm run build:server && vite --configLoader runner",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
